{
  "name": "@womenriseafg/server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "^8.3.0",
    "joi": "^18.3.2",
    "multer": "2.5.0",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "^22.15.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
