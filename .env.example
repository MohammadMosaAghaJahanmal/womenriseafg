# Copy to .env in this directory. Server process variables take precedence.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Use credentials for your own local, pre-created database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=womenriseafg
DB_USER=womenriseafg
DB_PASSWORD=

# Paths may be absolute or relative to this project root. Keep outside public web roots.
STORAGE_ROOT=storage
# Maximum size per media upload in bytes. Also set the host's request body limit.
MEDIA_MAX_UPLOAD_BYTES=134217728
# Maximum allowed duration in seconds when approving or publishing a Short.
SHORT_MAX_SECONDS=90

# In production set the exact browser-facing HTTPS origin (no path or trailing slash).
AUTH_PUBLIC_ORIGIN=
# Only trust the actual reverse proxy IPs after it is configured to overwrite forwarded headers.
AUTH_TRUSTED_PROXY_IPS=
