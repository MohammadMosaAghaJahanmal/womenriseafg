{
  "name": "womenriseafg",
  "version": "0.1.0",
  "private": true,
  "description": "Foundation for the free multilingual womenriseafg learning platform.",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "packageManager": "npm@11.21.3",
  "workspaces": [
    "client",
    "server"
  ],
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace @womenriseafg/client",
    "dev:server": "npm run dev --workspace @womenriseafg/server",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspace @womenriseafg/server",
    "build": "npm run build --workspaces",
    "start": "node app.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  }
}
